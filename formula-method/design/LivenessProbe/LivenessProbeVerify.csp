// LivenessProbe.csp 的独立验证入口。
#include "LivenessProbe.csp";

// 以下有限状态标记只用于验证，不属于探针角色本身。
var lp_seen_success = 0;
var lp_seen_failure = 0;
#define LPSuccessSeen lp_seen_success == 1;
#define LPFailureSeen lp_seen_failure == 1;

LPBranchTracker() = lp_success -> lp_mark_success{lp_seen_success = 1;} -> LPBranchTracker()
                  [] lp_failure -> lp_mark_failure{lp_seen_failure = 1;} -> LPBranchTracker();
LPChecked() = LPIdle() || LPBranchTracker();

// 独立探针模型的每个可达状态都能继续执行。
#assert LPIdle() deadlockfree;
// 存在 pgrep 零退出并报告 Success 的路径。
#assert LPChecked() reaches LPSuccessSeen;
// 存在 pgrep 非零退出或超时并报告 Failure 的路径。
#assert LPChecked() reaches LPFailureSeen;

// 探针调用后，最终报告结果，或被容器重启打断。
#assert LPIdle() |= [] (lp_invoke -> <> (lp_success || lp_failure || container_restart));
// pgrep 零退出后，下一步报告 Success，或发生重启。
#assert LPIdle() |= [] (lp_exit_zero -> X (lp_success || container_restart));
// pgrep 非零退出或超时后，下一步报告 Failure，或发生重启。
#assert LPIdle() |= [] ((lp_exit_nonzero || lp_timeout) -> X (lp_failure || container_restart));
