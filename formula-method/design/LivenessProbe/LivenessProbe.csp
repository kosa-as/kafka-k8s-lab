// M0 native LivenessProbe role; safe to include in the Kubelet composition.
// Source: Bitnami Kafka chart 32.5.0, pinned commit bb5e98a6e3c5ca196420d2414769b681c9284101,
// bitnami/kafka/templates/controller-eligible/statefulset.yaml, livenessProbe.
// Saved and live Pod spec: exec `pgrep -f kafka`, initialDelay 10 s,
// period 10 s, timeout 5 s, failureThreshold 3.
// Startup gate, counters, and restart are modeled in Kubelet.csp; timing is abstract.

LPIdle() = lp_invoke -> LPRunningExec()
         [] container_restart -> LPIdle();

LPRunningExec() = lp_exit_zero -> LPExitedZero()
                [] lp_exit_nonzero -> LPFailed()
                [] lp_timeout -> LPFailed()
                [] container_restart -> LPIdle();

LPExitedZero() = lp_success -> LPIdle()
               [] container_restart -> LPIdle();

LPFailed() = lp_failure -> LPIdle()
           [] container_restart -> LPIdle();
