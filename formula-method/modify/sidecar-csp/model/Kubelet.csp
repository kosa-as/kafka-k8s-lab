Kubelet() = [started == 0 && life >= 1 && life <= 6 && sp_fail < 30]
  k_startup_sample{
    if (life >= 2 && probe_net == 1) { started = 1; sp_fail = 0; }
    else { sp_fail++; }
  } -> Kubelet()
  [] [rp_result != 0] k_readiness_commit{
    if (rp_result == 1) { rp_fail = 0; ready = 1; }
    else { if (rp_fail < 6) { rp_fail++; } if (rp_fail == 6) { ready = 0; } }
    rp_result = 0;
  } -> Kubelet()
  [] [lp_result != 0] k_liveness_commit{
    if (lp_result == 1) { lp_fail = 0; } else { if (lp_fail < 3) { lp_fail++; } }
    lp_result = 0;
  } -> Kubelet()
  [] [restart_count == 0 && (life == 7 || sp_fail == 30 || lp_fail == 3)]
  k_restart{
    restart_count = 1; life = 0; started = 0; ready = 0;
    sp_fail = 0; rp_fail = 0; lp_fail = 0; rp_result = 0; lp_result = 0;
    bp = 0; response = 0; broker_expired = 0; exec_ok = 1; local_leader = 0;
    sc_started = 0; sc_ready = 0; sc_pending = 0; sc_valid = 0;
    sc_exec_valid = 0; sc_disk_valid = 0; sc_isr_valid = 0;
    sc_exec = 0; sc_disk = 0; sc_isr = 0;
    sc_exec_fail = 0; sc_disk_fail = 0; sc_isr_fail = 0; sc_exec_unknown = 0; sc_disk_unknown = 0; sc_isr_unknown = 0; sc_recover = 0;
  } -> Kubelet();
