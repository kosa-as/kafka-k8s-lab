#define COLD 0;
#define FAULT 0;
#define KIND 1;
#define HAS_DATA 0;
#define RECOVER 0;
#define ISSUE 0;
#define BACKGROUND 0;
#define N 2;
#define R 2;
#define LOSS 1;
#include "..\model\System.csp";
var test_step = 0;

// Directed submitted observations; actual Sidecar/Probe code is included above.
Inputs() =   [test_step == 0 && sc_pending == 0] input_0{sc_exec_valid=0;sc_exec=0;sc_disk_valid=0;sc_disk=0;sc_isr_valid=0;sc_isr=0;sc_valid=0;sc_pending=2;test_step=1;} -> Inputs()
  []   [test_step == 1 && sc_pending == 0] input_1{sc_exec_valid=0;sc_exec=0;sc_disk_valid=0;sc_disk=0;sc_isr_valid=0;sc_isr=0;sc_valid=0;sc_pending=2;test_step=2;} -> Inputs()
  []   [test_step == 2 && sc_pending == 0] test_idle -> Inputs();
Test() = Inputs() ||| Sidecar();
#define Done test_step == 2 && sc_pending == 0;
#define Expected sc_exec_fail == 0 && sc_disk_fail == 0 && sc_isr_fail == 0 && sc_ready == 0;
#assert Test() reaches Done;
#assert Test() |= [] (Done -> Expected);
ProbeStart() = [test_step == 2 && sc_pending == 0] test_probe_start -> LivenessProbe();
ProbeTest() = Inputs() ||| Sidecar() ||| ProbeStart();
#define ProbeExpected lp_result == 1;
#assert ProbeTest() reaches ProbeExpected;
// All scheduled LP samples in this completed scenario exclude the opposite result.
#define NoOppositeLp lp_result != 2;
#assert ProbeTest() |= [] NoOppositeLp;
