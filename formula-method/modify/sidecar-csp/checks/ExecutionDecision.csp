#define COLD 0;
#define FAULT 3;
#define KIND 1;
#define HAS_DATA 0;
#define RECOVER 0;
#define ISSUE 1;
#define BACKGROUND 1;
#define N 2;
#define R 2;
#define LOSS 0;
#include "..\model\System.csp";

#define ExecConfirmed sc_exec_fail == N;
#define LpFailure lp_result == 2;
#define ExecutionAction exec_ok == 0 && (lp_result == 2 || restart_count == 1);
#assert M1() reaches ExecConfirmed;
#assert M1() reaches ExecutionAction;
#assert M1() |= [] ((lp_sample && ExecConfirmed) -> LpFailure);
