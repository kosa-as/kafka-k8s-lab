#define COLD 0;
#define FAULT 5;
#define KIND 1;
#define HAS_DATA 0;
#define RECOVER 0;
#define ISSUE 1;
#define BACKGROUND 1;
#define N 2;
#define R 2;
#define LOSS 0;
#include "..\model\System.csp";

#define ReplicaConfirmed sc_valid == 1 && sc_isr_fail == N;
#define RpFailure rp_result == 2;
#define ReplicaNotReady sc_isr_fail == N && ready == 0;
#assert M1() reaches ReplicaConfirmed;
#assert M1() reaches ReplicaNotReady;
#assert M1() |= [] ((rp_sample && ReplicaConfirmed) -> RpFailure);
